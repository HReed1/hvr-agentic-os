"""Cadence CLI — 3-Tier Goal Management Engine for {{project_name}}.

Supports:
- Backends: SQLite (local/enterprise) or Google Cloud Firestore (cloud)
- 3-Tier Hierarchy: Monthly Strategic Milestones -> Weekly Sprints -> Daily Sessions
- Domain Phase Vocabularies with strict transition validation
- Ritual Commands: saturday-sync, week-plan

Usage:
    python3 scripts/cadence.py list --scope daily --status active
    python3 scripts/cadence.py create --title "Title" --scope daily --phase {{default_phase}}
    python3 scripts/cadence.py advance <goal_id> --phase {{next_phase}}
    python3 scripts/cadence.py complete <goal_id>
    python3 scripts/cadence.py saturday-sync
    python3 scripts/cadence.py week-plan
"""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import sqlite3
import sys
from typing import Any, Dict, List, Optional, Set, Tuple
import uuid

try:
    from google.cloud import firestore
    from google.cloud.firestore_v1.base_query import FieldFilter
except ImportError:
    firestore = None  # type: ignore

PROJECT_ROOT = Path(__file__).resolve().parent.parent
PROJECT_NAME = "{{project_name}}"
PROJECT_ID = "general-477613"
COLLECTION = "{{firestore_collection}}"
ARCHETYPE = "{{archetype}}"
CADENCE_BACKEND = "{{cadence_backend}}"
SQLITE_DB_PATH = PROJECT_ROOT / ".cadence" / "cadence.db"

VALID_SCOPES = ["monthly", "weekly", "daily"]
VALID_STATUSES = ["active", "pending", "completed", "deferred", "dropped"]
