+++ b/modules/nf-core/smoothxg/tests/main.nf.test
@@ -53,4 +53,29 @@ nextflow_process {
 
     }
 
+
+    test("smoothxg - stub") {
+
+        options "-stub"
+        config "./nextflow.config"
+
+        when {
+            process {
+                """
+                input[0] = [
+                    [ id:'test' ], // meta map
+                    file(params.modules_testdata_base_path + 'pangenomics/homo_sapiens/pangenome.smoothxg.gfa', checkIfExists: true)
